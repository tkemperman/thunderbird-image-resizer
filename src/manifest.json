{
  "manifest_version": 2,
  "name": "Image Resizer",
  "description": "__MSG_extensionDescription__",
  "version": "1.0.5",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "{0ca65651-d635-4f4f-b8fd-ed492e35dd46}",
      "strict_min_version": "128.0",
      "strict_max_version": "160.*"
    }
  },
  "permissions": [
    "compose"
  ],
  "background": {
    "page": "background.html"
  },
  "icons": {
    "16": "icons/image-resizer-16.png",
    "32": "icons/image-resizer-32.png",
    "48": "icons/image-resizer-48.png",
    "64": "icons/image-resizer-64.png",
    "128": "icons/image-resizer-128.png",
    "256": "icons/image-resizer-256.png"
  },
  "experiment_apis": {
    "imageResizeUI": {
      "schema": "api/imageResizeUI/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "imageResizeUI"
          ]
        ],
        "script": "api/imageResizeUI/implementation.js"
      }
    }
  }
}
